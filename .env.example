# =============================================================================
# AuraContent - environment variables
# =============================================================================
# Copy to `.env` (never commit it) and fill in what you have:
#     cp .env.example .env
# In CI the same names come from GitHub Secrets; on Onyxia, from Vault.
# Check what works with:  uv run python -m auracontent.cli.doctor
# Values are stripped of surrounding spaces/newlines, so copy-paste is safe.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM providers (script writing) - AT LEAST ONE is required.
# Each provider has its own free quota; the more you set, the fewer rate limits.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=            # also used for the Gemini TTS narration (edge-tts is the fallback)
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ZAI_API_KEY=               # Z.ai GLM (alias: ZHIPU_API_KEY)
DASHSCOPE_API_KEY=         # Qwen (alias: QWEN_API_KEY)
# GITHUB_TOKEN=            # GitHub Models - provided automatically in GitHub Actions

# Optional: provider order, comma-separated (default: built-in order)
# LLM_PROVIDERS=gemini,groq,cerebras,openrouter
# Optional: OpenRouter free models to try, comma-separated
# OPENROUTER_FREE_MODELS=

# -----------------------------------------------------------------------------
# Visuals (stock footage, archives, AI images) - all optional, more = better
# -----------------------------------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=
EUROPEANA_API_KEY=         # alias: EUROPEAN_API_KEY
POLLINATIONS_TOKEN=        # without it, AI images often fail with HTTP 402
CLOUDFLARE_ACCOUNT_ID=     # Cloudflare Workers AI (FLUX images + LLM)
CLOUDFLARE_API_TOKEN=      # needs the "Workers AI" permission; an R2-only token is not enough

# Wikipedia / Wikimedia require an identifying User-Agent, e.g.
# "AuraContent/2.0 (https://github.com/<you>/<repo>; you@example.com)"
WIKIMEDIA_CONTACT=

# -----------------------------------------------------------------------------
# Storage - Hugging Face (required in CI with --upload / --sync-state)
# -----------------------------------------------------------------------------
HF_TOKEN=                  # write access to the dataset below
# HF_STATE_REPO=soradata/AIShortvideos

# -----------------------------------------------------------------------------
# Publishing - Zernio (names referenced in config/channels/<channel>.yaml > publish)
# -----------------------------------------------------------------------------
ZERNIO_API_KEY=
TIKTOK_ACCOUNT_ID=
YOUTUBE_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Generation overrides - optional
# -----------------------------------------------------------------------------
# VIDEO_DURATION=45        # seconds, overrides brain.target_duration
# HOOK_BANDIT_EPSILON=0.2  # share of hooks picked for exploration (0-1)
